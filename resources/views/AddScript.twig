{% if ceresConfig.log.performanceLevel  == 'development' %}
    <script src="{{ plugin_path('Waldorfshop7') }}/js/dist/dia-vendor.js"></script>
    <script src="{{ plugin_path('Waldorfshop7') }}/js/dist/dia-app.js"></script>
{% else %}
    <script src="{{ plugin_path('Waldorfshop7') }}/js/dist/dia.min.js"></script>
{% endif %}
{% if services.template.isItem() %}
   <script type="module">
        import PhotoSwipeLightbox from '{{ plugin_path('Waldorfshop7') }}/js/dist/photoswipe-lightbox.esm.js';
        const lightbox = new PhotoSwipeLightbox({
        gallery: '#itemgallery',
        children: 'div',
        pswpModule: () => import('{{ plugin_path('Waldorfshop7') }}/js/dist/photoswipe.esm.js')
        });
        lightbox.init();
    </script>
{% endif %}
